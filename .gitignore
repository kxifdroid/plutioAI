# ==============================================================================
# PlutioAI .gitignore
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
client_secret*.json
credentials.json
token.json
service-account*.json

# --- Databases & Runtime Data ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
insights.db

# --- User Uploads & Media Assets ---
static/uploads/*
!static/uploads/.gitkeep
static/uploads/youtube_thumbnails/*
!static/uploads/youtube_thumbnails/.gitkeep
temp/
tmp/
*.mp3
*.wav
*.mp4
*.mov
*.webm
*.m4a
.insights/
insights_thumb_*
insights_lib_*
*.jsonl

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing, Coverage & Type Checking ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Logs & Process Files ---
*.log
*.pid
*.seed

# --- Operating System & Filesystem Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors & IDEs ---
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Node / Package Vestiges ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
